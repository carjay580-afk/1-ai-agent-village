# ============================================================================
# AI Agent Village — Production Environment Configuration
# Copy to .env for local overrides or configure in your cloud provider.
# ============================================================================

# Server bind address & port (cloud platforms inject PORT automatically)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
VILLAGE_REGION=ca-central-1

# ----------------------------------------------------------------------------
# Database Mode A (Managed / Container PostgreSQL — Recommended for Multi-Node)
# Leave blank to automatically use Mode B (Embedded Persistent PGlite).
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://village:changeme@postgres:5432/ai_agent_village
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=false
# PGPOOL_MAX=10

# ----------------------------------------------------------------------------
# Database Mode B (Zero-Config Embedded Persistent PostgreSQL 16 via PGlite)
# Automatically used when DATABASE_URL is unset.
# Defaults to /data/village-pgdata if /data volume is mounted, else .data/village-pgdata
# ----------------------------------------------------------------------------
# VILLAGE_DB_PATH=/data/village-pgdata

# Operational & Protection Settings
ENABLE_AUTOMATION_WORKER=true
RATE_LIMIT_MAX=240
